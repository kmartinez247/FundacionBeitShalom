# Copia este archivo como ".env" y llena tus datos. El archivo .env NO se sube a GitHub.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
FLASK_DEBUG=1

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_NAME=BeitShalomDB
# Si usas usuario y contraseña de SQL Server, llénalos.
# Si usas autenticación de Windows, deja DB_USER vacío.
DB_USER=sa
DB_PASSWORD=TuContraseña

# Para el panel: poner 1 cuando se publique con HTTPS
SESSION_COOKIE_SECURE=0
